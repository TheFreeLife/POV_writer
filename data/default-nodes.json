  {
    "id": "preset_sys_ai_config",
    "name": "AI 설정 노드",
    "icon": "🤖",
    "desc": "AI 플랫폼(OpenAI/Claude/Gemini), 모델명, API Key, 창의성(Temperature) 등 AI 생성 환경 설정을 구성하여 전달하는 노드",
    "category": "general",
    "color": "#38bdf8",
    "defaultWidth": 440,
    "defaultHeight": 360,
    "isDefault": true,
    "promptForName": true,
    "promptForDesc": false,
    "widgets": [
      {
        "id": "w_provider",
        "type": "dropdown_select",
        "label": "AI 플랫폼",
        "key": "provider",
        "options": ["OpenAI (ChatGPT)", "Anthropic (Claude)", "Google (Gemini)", "Custom (사용자 정의)"],
        "defaultVal": "OpenAI (ChatGPT)"
      },
      {
        "id": "w_model",
        "type": "dropdown_select",
        "label": "AI 모델",
        "key": "model",
        "options": ["gpt-4o", "gpt-4o-mini", "claude-3-5-sonnet", "claude-3-5-haiku", "gemini-1.5-pro", "gemini-1.5-flash"],
        "defaultVal": "gpt-4o"
      },
      {
        "id": "w_apikey",
        "type": "input_text",
        "label": "API Key",
        "key": "apiKey",
        "rows": 1,
        "placeholder": "sk-... (API Key를 입력하세요)"
      },
      {
        "id": "w_temp",
        "type": "input_text",
        "label": "창의성 (Temperature)",
        "key": "temperature",
        "rows": 1,
        "defaultVal": "0.7",
        "placeholder": "0.7 (0.0: 정확/일관됨 ~ 1.0: 창의적)"
      }
    ],
    "portsConfig": {
      "inputs": [],
      "outputs": [
        {
          "id": "out_1",
          "name": "AI 설정 데이터",
          "color": "#38bdf8"
        }
      ]
    },
    "code": "const provider = input['AI 플랫폼'] || input.provider || 'OpenAI (ChatGPT)';\nconst model = input['AI 모델'] || input.model || 'gpt-4o';\nconst apiKey = input['API Key'] || input.apiKey || '';\nconst temperature = parseFloat(input['창의성 (Temperature)'] || input.temperature || '0.7');\nreturn {\n  'AI 설정 데이터': {\n    provider,\n    model,\n    apiKey: apiKey ? (apiKey.slice(0, 7) + '...' + apiKey.slice(-4)) : '(API Key 미설정)',\n    rawApiKey: apiKey,\n    temperature: isNaN(temperature) ? 0.7 : temperature\n  }\n};"
  }
