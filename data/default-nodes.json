    },
    "code": "const 프로필 = `📌 《 ${input.name || '미정'} 》\\n• 소속: ${input.role || '미정'}\\n• 특징: ${input.traits || '없음'}`;\nreturn { '프로필 데이터': 프로필 };"
  },
