        "placeholder": "이름을 입력하세요 (예: 강현우)"
      },
      {
        "id": "w_role",
        "type": "input_text",
        "label": "소속 / 정체",
        "key": "role",
        "rows": 1,
        "placeholder": "소속 및 정체 (예: 중앙 아카데미 3학년)"
      },
      {
        "id": "w_traits",
        "type": "input_text",
        "label": "성격 및 주요 특징",
