        "key": "traits",
        "rows": 3,
        "defaultVal": "",
        "placeholder": "캐릭터 성격, 외모, 배경 특징..."
      }
    ],
    "portsConfig": {
      "inputs": [],
      "outputs": [
        {
          "id": "out_1",
          "name": "프로필 데이터",
          "color": "#00ffcc"
        }
      ]
    },
    "code": "const 프로필 = `📌 《 ${input.name || '미정'} 》\\n• 소속: ${input.role || '미정'}\\n• 특징: ${input.traits || '없음'}`;\nreturn { '프로필 데이터': 프로필 };"
  },
